{
  "name": "onapi-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "pnpm --dir apps/extension package",
    "compile": "node scripts/build.mjs --development",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm dev",
    "watch": "pnpm dev",
    "debug": "code --extensionDevelopmentPath=apps/extension",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "typecheck:e2e": "tsc --noEmit -p apps/webviews/tests/tsconfig.json",
    "test:unit": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:ui": "playwright test --config apps/webviews/tests/ui/playwright.config.ts",
    "test:editor": "playwright test --config apps/webviews/tests/editor/playwright.config.ts",
    "test:websocket": "node scripts/test-sockets.mjs",
    "test:socketio": "node scripts/test-sockets.mjs --socketio",
    "check:ui": "node scripts/check-ui-migration.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm test:unit",
    "test": "pnpm test:unit"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@faker-js/faker": "^10.6.0",
    "@noble/hashes": "^2.4.0",
    "@onapi/api-converter": "workspace:*",
    "@onapi/contracts": "workspace:*",
    "@onapi/domain": "workspace:*",
    "@onapi/runtime": "workspace:*",
    "@onapi/webviews": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@postman/tough-cookie": "4.1.3-postman.1",
    "@types/file-saver": "^2.0.7",
    "@types/jsonpath": "^0.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "~26.6.5",
    "@types/postman-collection": "^3.5.11",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/url-parse": "^1.4.11",
    "@types/vscode": "1.101.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "curl-to-postmanv2": "^1.8.7",
    "esbuild": "^0.28.2",
    "i18next": "^26.5.10",
    "json-schema-faker": "0.6.3",
    "json5": "^2.2.3",
    "jsonschema": "^1.5.0",
    "lodash": "^4.18.1",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postman-collection": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.10.1"
}
