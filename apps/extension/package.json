{
  "name": "onapi",
  "displayName": "OnAPI",
  "version": "0.0.3",
  "private": true,
  "description": "Ultra-lightweight Rest API debugging tool for VS Code.",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "api client",
    "api debbug",
    "api testing",
    "apiclient",
    "bruno",
    "http client",
    "insomnia",
    "postman",
    "rest api",
    "rest client",
    "restclient",
    "server sent events",
    "socket.io",
    "socket.io client",
    "sse",
    "testing",
    "thunder client",
    "thunderclient",
    "websocket client"
  ],
  "homepage": "https://github.com/hazicy/onapi-vscode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazicy/onapi-vscode.git"
  },
  "publisher": "onapi",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "pnpm -w build",
    "package": "node ../../scripts/package-extension.mjs"
  },
  "dependencies": {
    "@onapi/api-converter": "workspace:*",
    "@onapi/contracts": "workspace:*",
    "@onapi/core": "workspace:*",
    "@onapi/domain": "workspace:*",
    "@onapi/runtime": "workspace:*",
    "axios": "^1.20.0",
    "curl-to-postmanv2": "^1.8.7",
    "express": "^5.3.0",
    "i18next": "^26.5.10",
    "lodash": "^4.18.1",
    "oxfmt": "0.74.0",
    "postman-code-generators": "^2.1.1",
    "postman-collection": "^5.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "~26.6.5",
    "@types/postman-collection": "^3.5.11",
    "@types/react": "^19.3.0",
    "@types/vscode": "1.101.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "socket.io": "^4.8.4",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "onapi.documentServicePort": {
          "type": "number",
          "default": 3000,
          "description": "%configuration.documentServicePort.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myExtension",
          "title": "onapi",
          "icon": "dist/images/onapi-activity.svg"
        }
      ]
    },
    "views": {
      "myExtension": [
        {
          "id": "onapiRequests",
          "name": "%view.requests%"
        },
        {
          "id": "onapiTests",
          "name": "%view.tests%",
          "collapsed": true
        },
        {
          "id": "onapiHistory",
          "name": "%view.history%",
          "collapsed": true
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "onapi.switchWorkspace",
          "when": "view == onapiRequests",
          "group": "1_workspace@1"
        },
        {
          "command": "openImportDataPanel",
          "when": "view == onapiRequests",
          "group": "1_workspace@2"
        },
        {
          "command": "openExportDataPanel",
          "when": "view == onapiRequests",
          "group": "1_workspace@3"
        },
        {
          "command": "onapi.openEnv",
          "when": "view == onapiRequests",
          "group": "@2",
          "order": 1
        },
        {
          "command": "onapi.openExtenisonSettings",
          "when": "view == onapiRequests",
          "group": "@2",
          "order": 2
        },
        {
          "command": "onapi.tree.new",
          "when": "view == onapiRequests",
          "group": "navigation@4"
        },
        {
          "command": "onapi.tree.filter",
          "when": "view == onapiRequests",
          "group": "navigation@5"
        },
        {
          "command": "onapi.tree.refresh",
          "when": "view == onapiRequests",
          "group": "2_view@1"
        },
        {
          "command": "onapi.tree.runTests",
          "when": "view == onapiTests",
          "group": "navigation@1"
        },
        {
          "command": "onapi.tree.refresh",
          "when": "view == onapiTests || view == onapiHistory",
          "group": "navigation@3"
        },
        {
          "command": "onapi.tree.filter",
          "when": "view == onapiHistory",
          "group": "navigation@2"
        },
        {
          "command": "onapi.shareList",
          "when": "view == onapiRequests",
          "group": "1_workspace@4"
        }
      ],
      "view/item/context": [
        {
          "command": "onapi.tree.new",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "inline"
        },
        {
          "command": "onapi.tree.runTests",
          "when": "view == onapiTests && viewItem == onapiTestFolder",
          "group": "inline"
        },
        {
          "command": "onapi.tree.deleteReport",
          "when": "view == onapiTests && viewItem == onapiReport",
          "group": "management"
        },
        {
          "command": "onapi.tree.rename",
          "when": "view == onapiRequests && viewItem =~ /^(onapiFolder|onapiRequest|onapiRequestHttp)$/",
          "group": "3_edit@1"
        },
        {
          "command": "onapi.tree.clone",
          "when": "view == onapiRequests && viewItem =~ /^onapiRequest/",
          "group": "3_edit@2"
        },
        {
          "command": "onapi.tree.delete",
          "when": "view == onapiRequests && viewItem =~ /^(onapiFolder|onapiRequest|onapiRequestHttp)$/",
          "group": "4_delete"
        },
        {
          "command": "onapi.tree.copyCurl",
          "when": "view == onapiRequests && viewItem == onapiRequestHttp",
          "group": "2_copy"
        },
        {
          "command": "onapi.tree.revealStorage",
          "when": "view == onapiRequests && viewItem =~ /^(onapiFolder|onapiRequest|onapiRequestHttp)$/",
          "group": "2_reveal"
        },
        {
          "command": "onapi.tree.folderSettings",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "3_edit@0"
        },
        {
          "command": "onapi.tree.folderReports",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "1_test@2"
        },
        {
          "command": "onapi.tree.new.api",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "0_new@0"
        },
        {
          "command": "onapi.tree.new.sse",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "0_new@1"
        },
        {
          "command": "onapi.tree.new.graphql",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "0_new@2"
        },
        {
          "command": "onapi.tree.new.websocket",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "0_new@3"
        },
        {
          "command": "onapi.tree.new.socketio",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "0_new@4"
        },
        {
          "command": "onapi.tree.new.folder",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "0_new@5"
        },
        {
          "command": "onapi.tree.runTests",
          "when": "view == onapiRequests && viewItem == onapiFolder",
          "group": "1_test@1"
        },
        {
          "command": "onapi.tree.shareDocs",
          "when": "view == onapiRequests && viewItem =~ /^(onapiFolder|onapiRequestHttp)$/",
          "group": "2_copy@2"
        }
      ]
    },
    "commands": [
      {
        "command": "onapi.switchWorkspace",
        "title": "%command.switchWorkspace%",
        "icon": {
          "light": "dist/images/workspace-switch-light.svg",
          "dark": "dist/images/workspace-switch-dark.svg"
        }
      },
      {
        "command": "onapi.openEnv",
        "title": "%command.openEnv%"
      },
      {
        "command": "onapi.openExtenisonSettings",
        "title": "%command.openExtenisonSettings%"
      },
      {
        "command": "openImportDataPanel",
        "title": "%command.importData%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "openExportDataPanel",
        "title": "%command.exportData%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "onapi.tree.new",
        "title": "%command.tree.new%",
        "icon": "$(add)"
      },
      {
        "command": "onapi.tree.filter",
        "title": "%command.tree.filter%",
        "icon": "$(filter)"
      },
      {
        "command": "onapi.tree.refresh",
        "title": "%command.tree.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "onapi.tree.open",
        "title": "Open Request"
      },
      {
        "command": "onapi.tree.runTests",
        "title": "%command.tree.runTests%",
        "icon": "$(play)"
      },
      {
        "command": "onapi.tree.deleteReport",
        "title": "%command.tree.deleteReport%",
        "icon": "$(trash)"
      },
      {
        "command": "onapi.tree.rename",
        "title": "%command.tree.rename%",
        "icon": "$(edit)"
      },
      {
        "command": "onapi.tree.clone",
        "title": "%command.tree.clone%",
        "icon": "$(copy)"
      },
      {
        "command": "onapi.tree.delete",
        "title": "%command.tree.delete%",
        "icon": "$(trash)"
      },
      {
        "command": "onapi.tree.copyCurl",
        "title": "%command.tree.copyCurl%",
        "icon": "$(copy)"
      },
      {
        "command": "onapi.tree.revealStorage",
        "title": "%command.tree.revealStorage%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "onapi.tree.folderSettings",
        "title": "%command.tree.folderSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "onapi.tree.folderReports",
        "title": "%command.tree.folderReports%",
        "icon": "$(history)"
      },
      {
        "command": "onapi.tree.new.api",
        "title": "%command.tree.new.api%",
        "icon": "$(add)"
      },
      {
        "command": "onapi.tree.new.sse",
        "title": "%command.tree.new.sse%",
        "icon": "$(add)"
      },
      {
        "command": "onapi.tree.new.graphql",
        "title": "%command.tree.new.graphql%",
        "icon": "$(add)"
      },
      {
        "command": "onapi.tree.new.websocket",
        "title": "%command.tree.new.websocket%",
        "icon": "$(add)"
      },
      {
        "command": "onapi.tree.new.socketio",
        "title": "%command.tree.new.socketio%",
        "icon": "$(add)"
      },
      {
        "command": "onapi.tree.new.folder",
        "title": "%command.tree.new.folder%",
        "icon": "$(new-folder)"
      },
      {
        "command": "onapi.shareList",
        "title": "%command.shareList%",
        "category": "onapi",
        "icon": "$(book)"
      },
      {
        "command": "onapi.tree.shareDocs",
        "title": "%command.tree.shareDocs%",
        "icon": "$(link)"
      }
    ]
  },
  "activationEvents": [],
  "icon": "dist/images/onapi-icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "sandbox": false
}
