{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:debug",
      "type": "process",
      "command": "node",
      "args": ["scripts/start-debug.mjs"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "options": {
        "env": {
          "NO_COLOR": "1"
        },
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "build:debug",
      "type": "shell",
      "command": "pnpm",
      "args": ["compile"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "dev:stop",
      "type": "process",
      "command": "node",
      "args": ["scripts/stop-debug.mjs"],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
